# ===== Application =====
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===== Base de données (PostgreSQL) =====
POSTGRES_USER=africontext
POSTGRES_PASSWORD=change-me
POSTGRES_DB=africontext
DATABASE_URL=postgresql://africontext:change-me@localhost:5432/africontext?schema=public
# Production (Neon) : DATABASE_URL = URL poolée (hôte « -pooler »), DATABASE_URL_UNPOOLED = URL directe pour les migrations
# DATABASE_URL_UNPOOLED=
# Base dédiée aux tests d'intégration (jamais la base de dev)
TEST_DATABASE_URL=postgresql://africontext:change-me@localhost:5432/africontext_test?schema=public

# ===== Authentification (Auth.js) =====
# Générer avec : npx auth secret   (ou n'importe quelle chaîne aléatoire de 32+ caractères)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# GitHub OAuth (facultatif) : https://github.com/settings/developers
# Callback : <NEXT_PUBLIC_APP_URL>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth (facultatif) : https://console.cloud.google.com/apis/credentials
# URI de redirection autorisé : <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ===== Veille d'obsolescence (tâche planifiée) =====
CRON_SECRET=change-me-cron-secret
# true uniquement en local, pour que la veille et le brouillon IA puissent lire la sandbox (localhost)
ALLOW_PRIVATE_FETCH=false

# ===== Sandbox (faux serveurs Wave / Orange Money / FedaPay) =====
SANDBOX_URL=http://localhost:4010

# ===== IA (brouillon assisté F11 + capture des preuves F9) — facultatif =====
# Option gratuite : Google Gemini (clé sur https://aistudio.google.com/apikey)
AI_PROVIDER=openai
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Autres options gratuites compatibles OpenAI :
#   Groq   : AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile  (clé sur https://console.groq.com/keys)
#   Ollama : AI_BASE_URL=http://localhost:11434/v1        AI_MODEL=qwen2.5-coder         AI_API_KEY=ollama (100 % local)
# Claude (payant) : AI_PROVIDER=anthropic, sans AI_BASE_URL, AI_MODEL=claude-sonnet-5-5

# ===== Production (docker compose --profile prod) =====
DOMAIN=africontext.example.com
